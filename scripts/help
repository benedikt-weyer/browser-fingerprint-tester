#!/usr/bin/env bash
set -euo pipefail

cat <<'EOF'
Available commands:

  help          Show this list of available commands
  pnpm start    Start the dev server with hot reload (http://localhost:3000)
  pnpm install  Install project dependencies
  docker build -t browser-fingerprint-tester .   Build the container image
  docker run -p 8080:8080 browser-fingerprint-tester   Run the container (http://localhost:8080)
EOF
